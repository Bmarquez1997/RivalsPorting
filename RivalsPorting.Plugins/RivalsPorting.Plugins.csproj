<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UEFormatRoot>$(MSBuildThisFileDirectory)..\Dependencies\UEFormat</UEFormatRoot>
        <UEFormatBlenderDest>$(MSBuildThisFileDirectory)Blender\rivals_porting\ueformat</UEFormatBlenderDest>
        <UEFormatUnrealDest>$(MSBuildThisFileDirectory)Unreal\UEFormat</UEFormatUnrealDest>
        <UEFormatUnrealPlugin>$(UEFormatRoot)\plugins\unreal\UEFormat\UEFormat.uplugin</UEFormatUnrealPlugin>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Blender\**" Exclude="Blender\rivals_porting\ueformat\**" />
        <AvaloniaResource Include="Unreal\**" Exclude="Unreal\UEFormat\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Unity\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Unreal\RivalsPorting\Source\RivalsPorting\RivalsPorting.Build.cs" />
        <Content Include="Unreal\RivalsPorting\Source\RivalsPorting\RivalsPorting.Build.cs" />
        <Compile Remove="Unreal\UEFormat\**\*.cs" />
    </ItemGroup>

    <Target Name="SyncUEFormatPlugins" BeforeTargets="PrepareForBuild;GenerateAvaloniaResources">
        <Error Condition="!Exists('$(UEFormatUnrealPlugin)')"
               Text="UEFormat submodule is missing." />

        <ItemGroup>
            <UEFormatBlenderSource Include="$(UEFormatRoot)\plugins\blender\io_scene_ueformat\**\*" />
            <UEFormatUnrealSource Include="$(UEFormatRoot)\plugins\unreal\UEFormat\**\*"
                                  Exclude="$(UEFormatRoot)\plugins\unreal\UEFormat\Intermediate\**" />
        </ItemGroup>

        <Copy SourceFiles="@(UEFormatBlenderSource)"
              DestinationFiles="@(UEFormatBlenderSource->'$(UEFormatBlenderDest)\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(UEFormatUnrealSource)"
              DestinationFiles="@(UEFormatUnrealSource->'$(UEFormatUnrealDest)\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />

        <ItemGroup>
            <AvaloniaResource Include="Blender\rivals_porting\ueformat\**\*" />
            <AvaloniaResource Include="Unreal\UEFormat\**\*" Exclude="Unreal\UEFormat\Intermediate\**" />
            <Compile Remove="Unreal\UEFormat\**\*.cs" />
        </ItemGroup>
    </Target>
</Project>